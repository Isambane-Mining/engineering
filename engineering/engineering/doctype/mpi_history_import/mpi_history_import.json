{
 "doctype": "DocType",
 "name": "MPI History Import",
 "module": "Engineering",
 "engine": "InnoDB",
 "field_order": [
  "imei",
  "start_date",
  "end_date",
  "include_report",
  "vehicles",
  "execution_section",
  "status",
  "started_at",
  "completed_at",
  "records_processed",
  "last_error",
  "endpoint_outcomes"
 ],
 "fields": [
  {
   "fieldname": "imei",
   "fieldtype": "Data",
   "label": "Legacy MPI IMEI",
   "description": "Retained for previously saved single-vehicle imports.",
   "hidden": 1
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date (UTC)",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date (UTC, inclusive)",
   "reqd": 1,
   "description": "One to seven completed UTC days. Current/future UTC days are not accepted."
  },
  {
   "fieldname": "include_report",
   "fieldtype": "Check",
   "label": "Include Audited Mileage Activity Report",
   "default": "0",
   "description": "Optional. Requires an existing MPI Results vehicle identity and the audited Mileage report template."
  },
  {
   "fieldname": "vehicles",
   "fieldtype": "Table",
   "label": "Vehicles",
   "options": "MPI History Vehicle",
   "description": "Add selected vehicles from API MPI Settings. The UTC date range applies to every vehicle (maximum 500). One vehicle is also supported."
  },
  {
   "fieldname": "execution_section",
   "fieldtype": "Section Break",
   "label": "Execution"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nQueued\nRunning\nCompleted\nPartial\nFailed",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "Started At (UTC)",
   "read_only": 1
  },
  {
   "fieldname": "completed_at",
   "fieldtype": "Datetime",
   "label": "Completed At (UTC)",
   "read_only": 1
  },
  {
   "fieldname": "records_processed",
   "fieldtype": "Int",
   "label": "Distinct Records Processed",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Long Text",
   "label": "Last Error",
   "read_only": 1
  },
  {
   "fieldname": "endpoint_outcomes",
   "fieldtype": "JSON",
   "label": "Endpoint Outcomes",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "Engineering Manager",
   "read": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "Engineering Area Manager",
   "read": 1,
   "create": 0,
   "write": 0
  },
  {
   "role": "Engineering User",
   "read": 1,
   "create": 0,
   "write": 0
  },
  {
   "role": "Fleet Manager",
   "read": 1,
   "create": 0,
   "write": 0
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "allow_rename": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "MPI-HI-.YYYY.-.#####"
}
